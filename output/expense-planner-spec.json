        {
          "mois": "Décembre",
          "rev": 0,
          "obj": 0
        }
      ],
      "totals_row": {
        "label": "TOTAL",
        "formulas": {
          "rev": "=SUM(B{firstrow}:B{lastrow})",
          "obj": "=SUM(C{firstrow}:C{lastrow})"
        }
      },
      "freeze": {
        "rows": 1,
        "cols": 1
      }
    },
    {
      "name": "Janvier",
      "columns": [
        {
          "header": "Catégorie",
          "key": "cat",
          "width": 150,
          "format": "@"
        },
        {
          "header": "Budget prévu",
          "key": "budget",
          "width": 120,
          "format": "#,##0 €"
        },
        {
          "header": "Dépensé réel",
          "key": "reel",
          "width": 120,
          "format": "#,##0 €"
        },
        {
          "header": "Écart",
          "key": "ecart",
          "width": 110,
          "format": "#,##0 €",
          "formula": "=B{row}-C{row}"
        },
        {
          "header": "% utilisé",
          "key": "pct",
          "width": 100,
          "format": "0%",
          "formula": "=IF(B{row}=0,0,C{row}/B{row})"
        }
      ],
      "rows": [
        {
          "cat": "Logement",
          "budget": 900,
          "reel": 0
        },
        {
          "cat": "Alimentation",
          "budget": 450,
          "reel": 0
        },
        {
          "cat": "Transport",
          "budget": 200,
          "reel": 0
        },
        {
          "cat": "Santé",
          "budget": 100,
          "reel": 0
        },
        {
          "cat": "Loisirs",
          "budget": 150,
          "reel": 0
        },
        {
          "cat": "Abonnements",
          "budget": 60,
          "reel": 0
        },
        {
          "cat": "Shopping",
          "budget": 120,
          "reel": 0
        },
        {
          "cat": "Autre",
          "budget": 80,
          "reel": 0
        }
      ],
      "totals_row": {
        "label": "TOTAL",
        "formulas": {
          "budget": "=SUM(B{firstrow}:B{lastrow})",
          "reel": "=SUM(C{firstrow}:C{lastrow})",
          "ecart": "=SUM(D{firstrow}:D{lastrow})",
          "pct": "=IF(SUM(B{firstrow}:B{lastrow})=0,0,SUM(C{firstrow}:C{lastrow})/SUM(B{firstrow}:B{lastrow}))"
        }
      },
      "freeze": {
        "rows": 1,
        "cols": 1
      },
      "conditional_formats": [
        {
          "range": "D{firstrow}:D{lastrow}",
          "type": "color_scale",
          "min": "#D4876B",
          "mid": "#F5EFE6",
          "max": "#5C7A6B"
        },
        {
          "range": "E{firstrow}:E{lastrow}",
          "type": "data_bar",
          "color": "#5C7A6B"
        }
      ]
    },
